[Unit]
Description=Sklad sync server + web app
After=network.target

[Service]
Type=simple
User=sklad-sync
Group=sklad-sync
WorkingDirectory=/var/lib/sklad-sync
# SKLAD_ACME_DOMAIN и SKLAD_CORS_ORIGIN лежат в /etc/sklad-sync/env
# (mode 0600, owner sklad-sync). Токены (метка→токен) — в /etc/sklad-sync/tokens.
# Оба файла кладёт bootstrap-sklad.sh; deploy-sklad.sh их не трогает.
EnvironmentFile=/etc/sklad-sync/env
# Многотенантность: -tokens-file задаёт соответствия 'tenantId: token', у каждого
# тенанта свой файл данных в -data-dir (<tenantId>.json). Домен авто-сертификата —
# из env SKLAD_ACME_DOMAIN (:443, Let's Encrypt). Статика — из /opt/sklad-sync/public.
ExecStart=/opt/sklad-sync/sklad-sync \
    -data-dir /var/lib/sklad-sync/tenants \
    -tokens-file /etc/sklad-sync/tokens \
    -static /opt/sklad-sync/public \
    -acme-cache /var/lib/sklad-sync/acme
Restart=always
RestartSec=2
# :443 — привилегированный порт, а пользователь непривилегированный.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sklad-sync

[Install]
WantedBy=multi-user.target
